APP_ENV=dev
HTTP_ADDR=:8080
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT=10s

# Hardening (Phase 10)
# Comma-separated origins; must not be * in prod.
CORS_ALLOWED_ORIGINS=*
MAX_BODY_BYTES=1048576
HTTP_REQUEST_TIMEOUT=30s

# Prometheus endpoints (internal only; bind to a private interface in prod)
METRICS_ADDR=:9091
WORKER_METRICS_ADDR=:9092

DATABASE_URL=postgres://cpd:cpd@localhost:5432/cpd?sslmode=disable

# Database tuning
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_CONN_MAX_LIFETIME=1h
DB_CONN_MAX_IDLE_TIME=30m
# 0 disables the server-side statement timeout
DB_STATEMENT_TIMEOUT=30s
# Logged at WARN when a query exceeds this; 0 disables slow query logging
DB_SLOW_QUERY_THRESHOLD=500ms

R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY=minioadmin
R2_SECRET_KEY=minioadmin
R2_BUCKET=cpd-photos
R2_REGION=auto

# Auth
JWT_SECRET=dev-only-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
PASSWORD_RESET_TTL=1h
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION=15m
PUBLIC_BASE_URL=http://localhost:3000

# Public gallery
SIGNED_URL_TTL=5m
GALLERY_UNLOCK_TTL=30m

# Analytics visitor hashing (falls back to JWT_SECRET when unset)
ANALYTICS_HASH_SALT=dev-only-change-me

# Billing (manual = offline stub provider)
BILLING_PROVIDER=manual
BILLING_WEBHOOK_SECRET=dev-only-change-me

# Event lifecycle (worker)
EVENT_PURGE_GRACE_DAYS=30
EXPIRY_WARN_DAYS=7

# Exports
EXPORT_TTL=24h
